<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_marketplace_schedule_form" model="ir.ui.view">
            <field name="name">marketplace.schedule.form</field>
            <field name="model">marketplace.schedule</field>
            <field name="arch" type="xml">
                <form string="Esquema de horarios para SLA-date">
                    <sheet>
                        <group>
                            <field name="crm_team"/>
                            <field name="monday_to_friday_"/>
                            <field name="saturday"/>
                            <field name="sunday"/>
                            
                            <field name="auxiliar_1" invisible="1"/>
                            <field name="auxiliar_2" invisible="1"/>

                            <field name="flex" 
                                   invisible="auxiliar_1 != 'True'"
                                   help="Este campo solo es para mercado libre con envio Flex"/>
                                   
                            <field name="sameDay_nextDay" 
                                   invisible="auxiliar_2 != 'True'"
                                   help="Este campo solo es para Shopify con envio Same day / Next day"/>
                                   
                            <field name="auto_fill_dates"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_marketplace_schedule_tree" model="ir.ui.view">
            <field name="name">marketplace.schedule.list</field>
            <field name="model">marketplace.schedule</field>
            <field name="arch" type="xml">
                <list string="Horarios SLA date">
                    <field name="crm_team"/>
                    <field name="monday_to_friday_"/>
                    <field name="saturday"/>
                    <field name="sunday"/>
                    <field name="auxiliar_1" column_invisible="1"/>
                    <field name="auxiliar_2" column_invisible="1"/>
                    
                    <field name="flex" optional="show"/>
                    <field name="sameDay_nextDay" optional="hide"/>
                    <field name="auto_fill_dates"/>
                </list>
            </field>
        </record>

        <record id="action_marketplace_schedule" model="ir.actions.act_window">
            <field name="name">Esquema de horarios para SLA-date</field>
            <field name="res_model">marketplace.schedule</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click para agregar un nuevo esquema de horarios SLA.
                </p>
            </field>
        </record>

        <menuitem id="menu_marketplace_schedule" 
                  name="Esquema de horarios SLA" 
                  parent="sale.sale_menu_root" 
                  sequence="20" 
                  groups="group_sla_date_user"/>
                  
        <menuitem id="menu_marketplace_schedule_list" 
                  name="Configuración" 
                  parent="menu_marketplace_schedule" 
                  action="action_marketplace_schedule"/>
    </data>
</odoo>