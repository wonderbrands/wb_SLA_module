<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sla_override_wizard_form" model="ir.ui.view">
        <field name="name">sla.override.wizard.form</field>
        <field name="model">sla.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Reasignación / Empuje Manual de SLA">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Utilice este asistente para posponer o reasignar la fecha límite de SLA en las órdenes de venta seleccionadas.
                    </div>
                    <group>
                        <group>
                            <field name="new_sla_date" widget="datetime"/>
                            <field name="marketplace"/>
                            <field name="reason" widget="radio"/>
                        </group>
                        <group>
                            <field name="note" placeholder="Detalle el motivo o número de incidencia si aplica..."/>
                        </group>
                    </group>
                    <group string="Órdenes de Venta Afectadas">
                        <field name="sale_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="channel"/>
                                <field name="date_order"/>
                                <field name="sla_date" string="SLA Actual"/>
                                <field name="sla_priority_level" string="Prioridad"/>
                                <field name="partner_id"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Aplicar Reasignación" name="action_apply_override" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action para abrir el Wizard desde sale.order -->
    <record id="action_sla_override_wizard_sale" model="ir.actions.act_window">
        <field name="name">Reasignar / Empujar SLA</field>
        <field name="res_model">sla.override.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
